    "step": {
      "user": {
        "title": "添加 HP 打印机",
        "description": "输入打印机的地址。填写名称可以自定义实体的命名方式——留空则使用型号名称。",
        "data": {
          "host": "主机名或 IP 地址",
          "name": "名称"
        },
        "data_description": {
          "host": "建议使用打印机的 mDNS 名称，例如 NPI2E7F3D.local，这样地址变化后依然有效。IP 地址也可以。",
          "name": "用于设备及其所有实体 ID。建议使用简短名称。"
        },
        "sections": {
          "advanced_settings": {
            "name": "高级设置",
            "data": {
              "port": "端口",
              "ssl": "使用 HTTPS",
              "password": "管理员密码"
            },
            "data_description": {
              "port": "打印机内置 Web 服务器的端口。保持 80，启用 HTTPS 后会自动切换到 443。",
              "ssl": "打印机使用自签名证书，不会对其做校验。",
              "password": "可选，当前未被使用：CDP 的写操作不需要任何凭据，而 LEDM 机型根本没有维护接口。保留是为了将来固件开始要求凭据时可用；它只存在内存里，从不发送。"
            }
          }
        }
      },
      "reconfigure": {
        "title": "重新配置打印机",
