		<ns0:DomainName typeof="dd:String" length="70" elementXPath="nadyn:DNSSDConfig/dd3:DomainName" access="readWrite" />

		<ns0:DNSSDPrintPreferredServiceSupport access="readWrite">

			<ns2:DNSSDPrintPreferredService>P9100</ns2:DNSSDPrintPreferredService>

			<ns2:DNSSDPrintPreferredService>IPP</ns2:DNSSDPrintPreferredService>

		</ns0:DNSSDPrintPreferredServiceSupport>

	</ns0:DNSSDConfigSupport>

	<ns0:ProxyConfigSupport>

		<ns0:ResourceURI typeof="dd:String" length="127" elementXPath="nadyn:ProxyConfig/dd:ResourceURI" access="readWrite" />

		<ns0:Port typeof="dd:Int" min="1" max="65535" step="1" elementXPath="nadyn:ProxyConfig/dd:Port" access="readWrite" />

		<ns0:UserName typeof="dd:String" length="63" elementXPath="nadyn:ProxyConfig/dd:UserName" access="readWrite" />

		<ns0:Password typeof="dd:String" length="31" elementXPath="nadyn:ProxyConfig/dd:Password" access="writeOnly" />

		<ns0:ProxySupport access="readWrite">

			<ns2:ProxySupport>off</ns2:ProxySupport>

			<ns2:ProxySupport>on</ns2:ProxySupport>

		</ns0:ProxySupport>

		<ns0:ProxyModeSupport access="readWrite">

			<ns3:ProxyMode>manual</ns3:ProxyMode>

		</ns0:ProxyModeSupport>

	</ns0:ProxyConfigSupport>

	<ns0:SNMPConfigWithVersionSupport>

		<ns0:SNMPSupport access="readWrite">

			<ns2:SNMP>enabled</ns2:SNMP>

			<ns2:SNMP>disabled</ns2:SNMP>

		</ns0:SNMPSupport>

		<ns0:AccessOptionSupport access="readWrite">

			<ns2:AccessOption>readWrite</ns2:AccessOption>

			<ns2:AccessOption>readOnly</ns2:AccessOption>

		</ns0:AccessOptionSupport>

		<ns0:GetCommunityNameConfigSupport access="readWrite">

			<ns2:GetCommunityNameConfig>publicAllowed</ns2:GetCommunityNameConfig>

			<ns2:GetCommunityNameConfig>publicNotAllowed</ns2:GetCommunityNameConfig>

		</ns0:GetCommunityNameConfigSupport>

		<ns0:GetCommunityName typeof="dd:String" length="23" access="readWrite" elementXPath="dd:SNMPConfigWithVersion/dd:GetCommunityName" />

		<ns0:SetCommunityName typeof="dd:String" length="23" access="readWrite" elementXPath="dd:SNMPConfigWithVersion/dd:SetCommunityName" />

		<ns0:Version typeof="dd:String" length="3" access="readOnly" elementXPath="dd:SNMPConfigWithVersion/dd:Version" />

	</ns0:SNMPConfigWithVersionSupport>

	<ns0:WebServicesConfigSupport>

		<ns0:WSDiscovery access="readWrite">

			<ns2:WSDiscovery>enabled</ns2:WSDiscovery>

			<ns2:WSDiscovery>disabled</ns2:WSDiscovery>

		</ns0:WSDiscovery>

		<ns0:WSPrint access="readWrite">

			<ns2:WSPrint>enabled</ns2:WSPrint>

			<ns2:WSPrint>disabled</ns2:WSPrint>

		</ns0:WSPrint>

		<ns0:WSScan typeof="dd:Boolean" selected="enabled" deselected="disabled" elementXPath="nadyn:NetAppsDyn/nadyn:WebServicesConfig/nadyn:WSScan" access="readWrite" />

	</ns0:WebServicesConfigSupport>

	<ns0:DHCPv6Support access="readWrite">

		<ns2:DHCPv6>enabled</ns2:DHCPv6>

