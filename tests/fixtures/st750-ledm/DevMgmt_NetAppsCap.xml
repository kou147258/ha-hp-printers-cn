		<ns2:LLMNR>enabled</ns2:LLMNR>

		<ns2:LLMNR>disabled</ns2:LLMNR>

	</ns0:LLMNRSupport>

	<ns0:HTTPSRedirectionSupport access="readWrite">

		<ns2:HTTPSRedirection>enabled</ns2:HTTPSRedirection>

		<ns2:HTTPSRedirection>disabled</ns2:HTTPSRedirection>

	</ns0:HTTPSRedirectionSupport>

	<ns0:P9100Support access="readWrite">

		<ns2:Port9100PrintingSupport>enabled</ns2:Port9100PrintingSupport>

		<ns2:Port9100PrintingSupport>disabled</ns2:Port9100PrintingSupport>

	</ns0:P9100Support>

	<ns0:DHCPv4FQDNSupport access="readWrite">

		<ns2:DHCPv4FQDN>enabled</ns2:DHCPv4FQDN>

