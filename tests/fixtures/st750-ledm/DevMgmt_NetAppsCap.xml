	</ns0:DHCPv4FQDNSupport>

	<ns0:IPP access="readWrite">

		<ns2:IPPSupport>enabled</ns2:IPPSupport>

		<ns2:IPPSupport>disabled</ns2:IPPSupport>

	</ns0:IPP>

	<ns0:WebScanSupport access="readWrite">

		<ns3:WebScan>enabled</ns3:WebScan>

		<ns3:WebScan>disabled</ns3:WebScan>

	</ns0:WebScanSupport>

	<ns0:DirectPrintSupport access="readWrite">

		<ns3:DirectPrint>disabled</ns3:DirectPrint>

		<ns3:DirectPrint>enabled</ns3:DirectPrint>

	</ns0:DirectPrintSupport>

	<ns0:WPADSettingsSupport>

		<ns0:ResourceURI typeof="dd:string" length="127" elementXPath="nadyn:NetAppsDyn/nadyn:WPADSettings/nadyn:ResourceURI" access="readOnly" />

		<ns0:Port typeof="dd:integer" elementXPath="nadyn:NetAppsDyn/nadyn:WPADSettings/nadyn:Port" min="0" max="65535" step="1" access="readOnly" />

		<ns0:WPADStatusSupport access="readOnly">

			<ns0:WPADStatus>failure</ns0:WPADStatus>

			<ns0:WPADStatus>inProgress</ns0:WPADStatus>

			<ns0:WPADStatus>notStarted</ns0:WPADStatus>

			<ns0:WPADStatus>success</ns0:WPADStatus>

		</ns0:WPADStatusSupport>

	</ns0:WPADSettingsSupport>

</ns0:NetAppsCap>