<ns0:NetAppsCap xmlns:ns0="http://www.hp.com/schemas/imaging/con/ledm/netappcap/2009/06/24" xmlns:ns2="http://www.hp.com/schemas/imaging/con/dictionaries/1.0/" xmlns:ns3="http://www.hp.com/schemas/imaging/con/ledm/netappdyn/2009/06/24" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.hp.com/schemas/imaging/con/ledm/netappcap/2009/06/24 ../schemas/NetAppsCap.xsd">

	<ns2:Version>

		<ns2:Revision>SVN-IPG-LEDM.567</ns2:Revision>

		<ns2:Date>2012-11-02</ns2:Date>

	</ns2:Version>

	<ns0:DNSSDConfigSupport>

		<ns0:MDNSSupport access="readWrite">

